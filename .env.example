# Copy to .env and fill in. Every value below is read at import time and the app
# refuses to boot without it.

# Postgres connection string. Neon in hosted environments, any Postgres locally.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/booksavat"

# Signing key for sessions and cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Origin better-auth builds callback URLs from. Must match the running app.
BETTER_AUTH_URL="http://localhost:3456"

# Google OAuth credentials from https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# PostHog (production only — ignored in development and Vercel preview).
# Project Settings → Project API Key / region host (us.i or eu.i).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Cloudflare R2 (object storage). See docs/STORAGE.md for dashboard setup.
# Required the first time code calls the R2 client (lazy assert).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="booksavat"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# Public origin for keys under public/ (r2.dev subdomain or custom domain; no trailing slash).
R2_PUBLIC_BASE_URL=""
# Set true locally to exercise storage.createDevUploadUrl / verifyDevObject.
R2_DEV_PING_ENABLED="false"
